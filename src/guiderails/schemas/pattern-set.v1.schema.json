{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:guiderails:pattern-set:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "rules": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "examples": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 65536}},
    "argumentSelector": {
      "type": "object", "additionalProperties": false, "required": ["tool", "path"],
      "properties": {
        "tool": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "maxLength": 2048, "pattern": "^/(?:[^~]|~[01])*$"}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "enabled", "description", "priority", "scopes", "matcher", "edit_policy", "announce", "tests"],
      "if": {"anyOf": [{"required": ["argument"]}, {"required": ["arguments"]}]},
      "then": {"properties": {"scopes": {"const": ["tool.arguments"]}}},
      "not": {"required": ["argument", "arguments"]},
      "properties": {
        "id": {"type": "string", "maxLength": 160, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "revision": {"type": "integer", "minimum": 1},
        "enabled": {"type": "boolean"},
        "keep": {"type": "boolean", "default": true},
        "description": {"type": "string", "minLength": 1, "maxLength": 2048},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["assistant.text", "tool.arguments", "artifact.text", "tool.result"]}},
        "argument": {"$ref": "#/$defs/argumentSelector"},
        "arguments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/argumentSelector"}},
        "edit_policy": {"enum": ["introduced", "whole_result"]},
        "announce": {"type": "object", "additionalProperties": false, "required": ["instruction"], "properties": {"instruction": {"type": "string", "minLength": 1, "maxLength": 2048}}},
        "tests": {"type": "object", "additionalProperties": false, "required": ["positive", "negative"], "properties": {"positive": {"$ref": "#/$defs/examples"}, "negative": {"$ref": "#/$defs/examples"}}},
        "matcher": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["type", "value", "case_sensitive", "normalization"], "properties": {
              "type": {"const": "match"}, "value": {"type": "string", "minLength": 1, "maxLength": 4096}, "case_sensitive": {"type": "boolean"}, "normalization": {"enum": ["none", "nfc"]}
            }},
            {"type": "object", "additionalProperties": false, "required": ["type", "pattern", "flags", "normalization"], "properties": {
              "type": {"const": "regex"}, "pattern": {"type": "string", "minLength": 1, "maxLength": 4096},
              "flags": {"type": "array", "uniqueItems": true, "items": {"enum": ["IGNORECASE", "MULTILINE", "DOTALL"]}}, "normalization": {"enum": ["none", "nfc"]}
            }}
          ]
        }
      }
    }
  }
}
